[Unit]
Description=mtp-gateway
Wants=network-online.target
After=network-online.target
[Service]
User=mtp-gateway
Group=mtp-gateway
ExecStart=@@BINARY@@ serve --config /etc/mtp-gateway/gateway.toml
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0027
RuntimeDirectory=mtp-gateway
RuntimeDirectoryMode=0750
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/mtp-gateway
InaccessiblePaths=@@ADMIN_ROOT@@/pki @@ADMIN_ROOT@@/devices
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SocketBindDeny=any
@@PORTS@@
SocketBindAllow=udp
SystemCallArchitectures=native
LimitCORE=0
LimitNOFILE=8192
CPUWeight=50
MemoryHigh=256M
MemoryMax=384M
MemorySwapMax=128M
TasksMax=128
[Install]
WantedBy=multi-user.target
